{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadLabInstances",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    },
    {
      "Sid": "ControlOnlyOptedInLabInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances"
      ],
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "m5-clase1",
          "ec2:ResourceTag/AutoSchedule": "true"
        }
      }
    }
  ]
}
